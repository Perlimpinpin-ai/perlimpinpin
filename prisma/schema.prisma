// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidat {
  id         Int      @id @default(autoincrement())
  nom        String   @unique
  parti      String
  photoUrl   String?
  scoreMoyen Float?
  createdAt  DateTime @default(now())

  propositions Proposition[]
  liveAnalyses LiveAnalyse[]
}

model Proposition {
  id              Int      @id @default(autoincrement())
  // Titre court généré à partir de l'analyse (resume_court/mesure_reformulee),
  // pour l'affichage sur les cartes. Nullable pour les propositions
  // antérieures à l'ajout de ce champ.
  titre           String?
  texteOriginal   String
  theme           String
  dateDeclaration DateTime
  createdAt       DateTime @default(now())

  candidatId Int
  candidat   Candidat @relation(fields: [candidatId], references: [id])

  analyses    Analyse[]
  votesMesure VoteMesure[]
}

model Analyse {
  id Int @id @default(autoincrement())

  propositionId Int
  proposition   Proposition @relation(fields: [propositionId], references: [id])

  // Score global sur 100
  scoreFaisabilite Int

  // Sous-scores du barème (poids variables selon le critère, voir
  // scripts/analyze.js — colonnes historiques, non lues par l'UI qui lit
  // directement contenuComplet.notation_detaillee ; scoreJuridique/
  // scoreOperationnel/scorePertinence portent désormais des valeurs dont le
  // nom de colonne ne correspond plus exactement au libellé du critère,
  // voir le commentaire dans saveAnalysis())
  scoreSolidite     Int
  scoreJuridique    Int
  scoreOperationnel Int
  scoreBudgetaire   Int
  scorePertinence   Int

  verdict String

  // Résumé journalistique court (~200-250 caractères) pour la carte "Prix
  // de la semaine" de la page d'accueil. Nullable pour les analyses
  // antérieures à l'ajout de ce champ.
  resumeAccueil String?

  // Texte journalistique plus développé (~400-500 caractères) pour la
  // section "Le résumé de Perlimpinpin IA" en tête de la fiche déclaration.
  // Pose la mesure et le point de tension principal, sans donner le verdict
  // ni le score. Nullable pour les analyses antérieures à ce champ.
  teaser String?

  cequiEstEtabli     String
  cequiEstProbable   String
  cequiEstDiscutable String
  cequiEstInconnu    String

  sourcesUtilisees String

  // "brouillon" | "publie"
  statut String @default("brouillon")

  // Valeur en dur, jamais dérivée automatiquement — à faire évoluer
  // manuellement (1.1, 2.0...) le jour où data/prompt-methodologie.md
  // change vraiment. Affichée sur la fiche publique.
  versionMethodologie String @default("1.0")

  // Date de dernière modification de data/prompt-methodologie.md au moment
  // de la génération de cette analyse. Jamais affichée : sert uniquement de
  // filet de sécurité d'audit interne — comparée à createdAt, elle permet de
  // repérer une analyse générée après un changement de prompt dont
  // versionMethodologie n'aurait pas été remonté manuellement. Nullable :
  // absente pour les analyses générées avant l'ajout de ce champ.
  promptFileModifiedAt DateTime?

  // Réponse JSON complète renvoyée par l'API Anthropic (sortie finale, après
  // arbitrage de l'étape 3 du pipeline)
  contenuComplet Json

  // Sortie brute du contrôle qualité Mistral (étape 2 du pipeline). Nullable :
  // absent si Mistral a échoué (mode dégradé) ou pour les analyses générées
  // avant l'ajout de cette étape.
  contreAvisMistral Json?

  // Pour chaque remarque de contreAvisMistral, ce que Claude a accepté ou
  // rejeté et pourquoi (étape 3). Usage interne, jamais exposé au lecteur.
  auditArbitrage Json?

  // Détail des tokens et du coût estimé par étape du pipeline :
  // { tokensEtape1, tokensEtape2, tokensEtape3, coutEstimeTotal, tokensEtape4? }
  coutPipeline Json?

  // --- Pipeline V4 (voir data/prompt-arbitrage.md) : sépare l'analyse
  // interne qui fait foi du contenu traduit pour l'affichage public. ---

  // Analyse canonique interne (faits, sources, degrés de certitude, les 4
  // notes, qualification juridique complète avec affirmations_juridiques).
  // Fait foi pour tout recalcul ou audit. Ne doit jamais être exposée
  // directement au front-end. Nullable : absente sur les analyses
  // générées avant le pipeline V4 (voir versionMethodologie, utilisé comme
  // discriminant explicite de schéma côté front-end plutôt que la
  // déduction par présence de champs).
  analyseCanonique Json?

  // Contenu public final (étape 4, Mistral éditorial), c'est la seule
  // donnée que le front-end doit afficher pour une fiche V4. Nullable :
  // absent si l'étape éditoriale a échoué (utiliser alors
  // contenu_public_secours produit par l'étape 3, stocké ici aussi une
  // fois retenu) ou pour les analyses antérieures au pipeline V4.
  contenuPublic Json?

  // Contrôle de fidélité de la passe éditoriale (correspondance des points
  // obligatoires, citations/nombres/dates repris, absence de nouvelle
  // affirmation). Usage interne uniquement, jamais exposé au lecteur.
  controleFideliteEditorial Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feedbacks Feedback[]
}

model Feedback {
  id Int @id @default(autoincrement())

  analyseId Int
  analyse   Analyse @relation(fields: [analyseId], references: [id])

  // "like" | "dislike"
  type String

  // Raison du dislike, nullable (uniquement si type = "dislike")
  raison String?

  // Texte libre si raison = "autre"
  raisonAutre String?

  createdAt DateTime @default(now())
}

// Vote du lecteur sur la mesure politique elle-même (d'accord / pas
// d'accord), distinct de Feedback (qui porte sur la qualité de l'analyse
// de Perlimpinpin). Rattaché à Proposition, pas à Analyse : l'avis du
// lecteur porte sur la mesure telle qu'annoncée, indépendamment d'une
// éventuelle nouvelle version de l'analyse.
model VoteMesure {
  id Int @id @default(autoincrement())

  propositionId Int
  proposition   Proposition @relation(fields: [propositionId], references: [id])

  // "accord" | "desaccord"
  type String

  createdAt DateTime @default(now())
}

// Message libre envoyé via la modale "Nous contacter" du header (suggestion,
// question, signalement d'erreur) — sans authentification ni rattachement à
// une fiche particulière.
model MessageContact {
  id Int @id @default(autoincrement())

  nom     String?
  email   String?
  message String

  createdAt DateTime @default(now())
}

// Inscription à la newsletter depuis la modale du header. INSERTION SEULE :
// aucune mise à jour ni désinscription gérée pour l'instant.
model NewsletterSubscriber {
  id Int @id @default(autoincrement())

  email     String   @unique
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model Source {
  id  Int    @id @default(autoincrement())
  nom String
  url String

  // "institutionnelle" | "statistique" | "juridique" | "autre"
  type String

  createdAt DateTime @default(now())
}

// Analyse lancée depuis l'espace /live (PerlimpinpinGo, équipe éditoriale) :
// texte collé, estimation préliminaire produite par l'Étape 1 allégée.
// Distincte de Proposition/Analyse (pipeline public) : jamais publiée, sans
// lien avec les fiches du site. Le candidat est facultatif (choisi à la main
// dans le formulaire ; l'analyse ne l'identifie pas elle-même).
model LiveAnalyse {
  id Int @id @default(autoincrement())

  // Texte de la déclaration collé par la rédaction
  declaration String

  // Titre court : reformulation de la première mesure analysée
  titre String

  // Score moyen des mesures analysées (0-100, arrondi) et leur nombre
  score     Int
  nbMesures Int

  // Réponse complète de l'analyse (mesures, remarque, avertissements), pour
  // pouvoir la ré-afficher plus tard
  resultat Json

  // Dossier : slug de l'un des thèmes du site (src/lib/themes.js) ou "autre",
  // choisi par l'analyse. Les dossiers de /live sont ce regroupement
  // automatique, jamais une entité gérée à la main.
  theme String @default("autre")

  // OBSOLÈTE : ancien favori partagé par toute l'équipe (avant les comptes individuels).
  // Plus lu ni écrit par l'application : les favoris sont désormais personnels
  // (table LiveFavori). Colonne conservée pour ne perdre aucune donnée ; à supprimer
  // dans une migration ultérieure, une fois les comptes validés en production.
  favori Boolean @default(false)

  // --- Structure enrichie (page dédiée /live/analyses/[id]) ---
  // Toutes nullables : les analyses créées avant cet ajout n'ont pas ces
  // champs et s'affichent en version simplifiée. Le champ `titre` ci-dessus
  // reçoit désormais un titre court généré quand il est disponible.

  // Synthèse d'ensemble (1 à 2 phrases)
  syntheseGlobale String?

  // Une phrase par axe : Chiffrage, Faisabilité, Impact
  syntheseChiffrage   String?
  syntheseFaisabilite String?
  syntheseImpact      String?

  // "élevé" | "moyen" | "faible"
  confiance String?

  // [{ texte, verdict, sources: [id, …] }] — verdict parmi Cohérent, Plutôt
  // cohérent, Incertain, Non étayé, Contredit. null = analyse antérieure au
  // format enrichi ([] = format enrichi sans affirmation extraite).
  affirmations Json?

  // [{ id, nom, date, url }] — références connues du modèle (l'analyse live
  // n'effectue pas de recherche web) : à vérifier avant diffusion.
  sources Json?

  // Questions d'interview : { essentielles: [...], difficiles: [...], etendu }
  // Chaque question : { texte, justification, sources: [id, …], relance, angle }.
  // Générées avec l'analyse ; `etendu` passe à true quand la journaliste a
  // demandé l'interview complète (route dédiée, sans regénérer score ni
  // affirmations). null = analyse antérieure ou aucune question générée.
  questions Json?

  // Lien de la source d'origine, saisi (facultatif) à l'analyse : article, vidéo…
  // sourceVideo = plateforme vidéo reconnue à partir de ce lien ("youtube",
  // "dailymotion", "x", "francetv") ; null pour toute autre source (texte, fichier,
  // article). L'adresse du lecteur intégré n'est jamais stockée : elle est
  // reconstruite à l'affichage (src/lib/live-video.js).
  sourceUrl   String?
  sourceVideo String?

  // Conversation « Posez une question sur cette analyse » (LiveChatMessage)
  messages LiveChatMessage[]

  // Journaliste qui a lancé l'analyse. NULL pour les analyses créées avant les comptes
  // individuels (affichées comme « Équipe éditoriale (historique) »).
  auteurId Int?
  auteur   LiveUser? @relation(fields: [auteurId], references: [id])

  // Favoris personnels : un journaliste par ligne
  favoris LiveFavori[]

  candidatId Int?
  candidat   Candidat? @relation(fields: [candidatId], references: [id])

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([auteurId, createdAt])
}

// Compte individuel d'un journaliste de /live. Pas d'auto-inscription : les comptes
// sont créés en ligne de commande (scripts/create-live-user.js). Le mot de passe n'est
// jamais stocké en clair : uniquement son hachage bcrypt.
model LiveUser {
  id Int @id @default(autoincrement())

  // Adresse e-mail, toujours en minuscules (identifiant de connexion)
  email String @unique

  nom String

  motDePasseHash String

  createdAt DateTime @default(now())

  analyses LiveAnalyse[]
  favoris  LiveFavori[]
}

// Favori personnel : un journaliste a mis une analyse en favori. La ligne existe tant
// que l'analyse est en favori (création à l'ajout, suppression au retrait).
model LiveFavori {
  userId    Int
  user      LiveUser    @relation(fields: [userId], references: [id])
  analyseId Int
  analyse   LiveAnalyse @relation(fields: [analyseId], references: [id])

  createdAt DateTime @default(now())

  @@id([userId, analyseId])
  @@index([analyseId])
}

// Messages du chat d'une analyse live (« Posez une question sur cette analyse »).
// INSERTION SEULE, comme les autres tables de /live : une question et sa réponse
// sont ajoutées ensemble (deux lignes) ; jamais modifiées ni supprimées. Le code
// d'accès (src/lib/live-chat-db.js) n'expose que create et la lecture.
model LiveChatMessage {
  id Int @id @default(autoincrement())

  analyseId Int
  analyse   LiveAnalyse @relation(fields: [analyseId], references: [id])

  // "user" (la question du journaliste) | "assistant" (la réponse)
  role String

  content String

  createdAt DateTime @default(now())

  @@index([analyseId, createdAt])
}

// Commentaire de relecture éditoriale laissé sur une fiche en brouillon
// (/relectures). Rattaché à une fiche (ficheSlug) et à une section précise
// de la fiche (sectionId, ex: "zemmour-retraites-score"). Lecture et écriture
// réservées aux adhérents connectés (Club Perlimpinpin, /api/relectures/comments).
model RelectureComment {
  id           String    @id @default(cuid())
  ficheSlug    String
  sectionId    String
  sectionLabel String?
  authorName   String?
  body         String
  createdAt    DateTime  @default(now())
  // Annotation (surligneur + note) : passage cité et sa position, en
  // caractères, dans le texte de la section. Nuls pour un commentaire de section.
  quotedText   String?
  startOffset  Int?
  endOffset    Int?
  // Adhérent qui a écrit le commentaire (Club Perlimpinpin). Nul pour les
  // commentaires d'avant les comptes adhérents. authorName garde une copie du
  // nom au moment du commentaire. Si le compte est supprimé, le commentaire
  // reste (SetNull).
  adherentId   Int?
  adherent     Adherent? @relation(fields: [adherentId], references: [id], onDelete: SetNull)
  // Commentaire retenu, c'est-à-dire pris en compte dans la version suivante
  // de la fiche (+20 PerlimpinPOINTS). Mis à true uniquement par
  // scripts/marquer-retenus.js, jamais remis à false automatiquement.
  retenu       Boolean   @default(false)

  @@index([ficheSlug, sectionId])
  @@index([adherentId])
}

// Chronomètre de relecture d'une fiche en brouillon (/relectures), rattaché
// par ficheSlug comme RelectureComment. Une fois reviewDeadline passée, les
// commentaires sont fermés et la fiche est "Prête à publier" — aucune
// publication automatique. Les deux dates restent nulles tant que le chrono
// n'a pas été lancé (ou après un arrêt).
model RelectureFiche {
  id              String    @id @default(cuid())
  ficheSlug       String    @unique
  reviewStartedAt DateTime?
  reviewDeadline  DateTime?
}

// Adhérents de l'association : espace personnel de la page /relectures.
// Seules les adresses connues (import scripts/import-adherents.js, ou adhésion
// HelloAsso payée : voir src/lib/helloasso-core.js) peuvent créer un
// compte ; l'adhérent choisit lui-même son mot de passe à la première
// connexion (/relectures/inscription). Session séparée de /live (cookie signé
// relecture_auth, voir src/lib/relecture-auth-core.js).
model Adherent {
  id               Int       @id @default(autoincrement())
  // Adresse e-mail, toujours en minuscules (identifiant de connexion)
  email            String    @unique
  // Nom affiché (ex. "Camille D.")
  nom              String
  // Pseudonyme choisi par le membre, affiché à la place de `nom` dans le
  // Club. null = on affiche `nom`. Les e-mails utilisent toujours `nom`.
  pseudo           String?   @unique
  // Hachage bcrypt ; null = compte pas encore activé
  motDePasseHash   String?
  activatedAt      DateTime?
  createdAt        DateTime  @default(now())
  // Origine du compte : "helloasso" (adhésion payée) ou "import"
  // (scripts/import-adherents.js). null = compte antérieur à ce champ.
  source           String?
  // Commande HelloAsso qui a créé le compte. Unique : une commande ne crée
  // jamais deux comptes, même si la notification arrive plusieurs fois.
  helloassoOrderId Int?      @unique
  // Non null = ne reçoit plus les appels à relecture (lien de désinscription
  // des mails envoyés par scripts/relecture.js). Reste adhérent du Club.
  desinscritMailsRelectureAt DateTime?

  commentaires RelectureComment[]
}

// Textes modifiables des pages publiques (ex. /nous-rejoindre), édités depuis
// le mode édition de /test. La liste des textes possibles et leur valeur par
// défaut sont dans src/lib/textes-site.js : une ligne ici ne fait que
// REMPLACER un texte par défaut. Pas de ligne = texte par défaut affiché.
model TexteSite {
  // Page concernée, ex. "nous-rejoindre"
  page      String
  // Clé du texte dans la page, ex. "etape2.titre"
  cle       String
  valeur    String
  // +1 à chaque enregistrement (évite d'écraser la modification d'un autre)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([page, cle])
}
