# Copiez ce fichier en .env et renseignez les vraies valeurs. .env est ignoré par git.

# Exemple (valeurs factices) : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
DIRECT_URL=

# Requis par scripts/analyze.js pour appeler l'API Anthropic
ANTHROPIC_API_KEY=

# Requis par scripts/analyze.js (étape 2 du pipeline) pour appeler l'API Mistral
MISTRAL_API_KEY=

# Espace /live (décryptage en direct, équipe éditoriale) : comptes individuels
# Secret Auth.js (next-auth) qui chiffre le cookie de session. OBLIGATOIRE : sans lui,
# personne ne peut se connecter à /live. Valeur aléatoire, propre à chaque environnement.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changer cette valeur déconnecte tout le monde.
AUTH_SECRET=
# Les comptes se créent avec : node scripts/create-live-user.js --email ... --nom "..." --generer
# L'espace adhérents de /relectures (cookie relecture_auth) réutilise aussi AUTH_SECRET pour signer sa session.

# Pages de relecture /test (brouillons) : « code d'édition » unique, indépendant de /live.
# Sans ce code (ou s'il fait moins de 12 caractères), le mode édition n'existe pas :
# /test reste en lecture seule et personne ne peut publier. Choisir un code long et aléatoire.
# Changer cette valeur déconnecte immédiatement toutes les sessions d'édition en cours.
# La signature du cookie réutilise AUTH_SECRET (ci-dessus), qui doit donc aussi être défini.
TEST_EDIT_CODE=
# Mettre 1 pour le mode simulation : le bouton « Publier » calcule et annonce ce qui se passerait
# (nouvelle moyenne du candidat) mais n'écrit RIEN en base. Vide ou absent = vraie publication.
TEST_DRY_RUN=

# Page /relectures (brouillons étape 1) : code comité pour lancer / prolonger / arrêter le
# chrono de relecture. Sans ce code (ou s'il fait moins de 12 caractères), les chronos ne
# sont pas modifiables (réponse 401). Les commentaires restent ouverts à tous.
RELECTURE_ADMIN_CODE=

# Club Perlimpinpin : création automatique des comptes adhérents depuis HelloAsso
# (src/lib/helloasso.js, /api/helloasso/notification, /api/helloasso/sync).
# Si l'une de ces variables manque, les deux routes répondent 503 et ne font rien.
# Clé d'API de l'association (HelloAsso > Mon compte > Intégrations et API)
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Slug de l'association et des formulaires d'adhésion (visibles dans l'adresse du formulaire :
# https://www.helloasso.com/associations/<organisation>/adhesions/<formulaire>).
# Plusieurs formulaires : slugs séparés par des virgules, ex. mensuel-slug,annuel-slug
HELLOASSO_ORGANIZATION_SLUG=
HELLOASSO_MEMBERSHIP_FORM_SLUG=
# Sandbox en local : https://api.helloasso-sandbox.com — production (Vercel) : https://api.helloasso.com
HELLOASSO_API_BASE=
# Jeton secret ajouté à l'URL de notification (?token=...). 32 caractères minimum.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HELLOASSO_WEBHOOK_TOKEN=
# Secret des Cron Jobs Vercel (synchronisation quotidienne /api/helloasso/sync), 16 caractères minimum.
# Vercel l'envoie automatiquement dans « Authorization: Bearer ... ».
CRON_SECRET=

# Mails du Club envoyés depuis la boîte Zimbra (club@perlimpinpin.ai), en SMTP :
# mail de bienvenue automatique à chaque nouvel adhérent HelloAsso
# (src/lib/mail-bienvenue.js, scripts/envoyer-bienvenue.js). À renseigner aussi
# dans Vercel (Production). Sans ces variables, les comptes sont créés quand même
# mais aucun mail ne part. Le mot de passe n'est jamais affiché ni journalisé.
# Hébergement OVH : CLUB_SMTP_HOST=smtp.mail.ovh.net ; port 587 (STARTTLS) ou 465 (TLS).
CLUB_SMTP_HOST=
CLUB_SMTP_PORT=
# Adresse complète de la boîte : club@perlimpinpin.ai
CLUB_SMTP_USER=
CLUB_SMTP_PASSWORD=
# Mail d'annonce des fiches en relecture (/relectures, mode comité) : même boîte
# SMTP. Adresse qui reçoit le bouton « M'envoyer un test ». À renseigner aussi dans Vercel.
ANNONCE_TEST_EMAIL=
